<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.etf.sell-signal-radar</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{SELL_RADAR_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SYNC_PROFILE</key>
		<string>sell-signal-radar</string>
		<key>RUN_SELL_SIGNAL_RADAR</key>
		<string>1</string>
		<key>RUN_SELL_SIGNAL_EMAIL</key>
		<string>1</string>
		<key>C18ACC_EXTENSION_POLL_MIN</key>
		<string>5</string>
		<key>SIGNAL_RADAR_SELL_HELD_ONLY</key>
		<string>1</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- Mon–Fri 09:06–13:20 每 5 分鐘 -->
{{SELL_RADAR_CALENDAR_INTERVALS}}
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.etf/sell-signal-radar.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.etf/sell-signal-radar.launchd.err.log</string>
	<key>ExitTimeOut</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
