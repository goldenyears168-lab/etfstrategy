<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.futopt-books-collect</string>
	<!-- CCF/TMF 五檔＋逐筆 websocket 收集器（唯讀）
	     order_capable=false：本 job 只讀取／記錄，不含任何送單路徑。
	     刻意不設任何 ORDER_* 旗標——它沒有下單能力，給了只會誤導。 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{FUTOPT_BOOKS_COLLECT_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>GOLDENSTOCKS_DATA_DIR</key>
		<string>{{HOME}}/goldenstocks-data</string>
		<key>TZ</key>
		<string>Asia/Taipei</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- 常駐 collector：KeepAlive（腳本自己處理重連與時窗）；勿改 StartInterval -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/futopt-books-collect.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/futopt-books-collect.launchd.err.log</string>
</dict>
</plist>
