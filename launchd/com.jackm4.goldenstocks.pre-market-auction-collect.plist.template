<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.pre-market-auction-collect</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{PRE_MARKET_AUCTION_COLLECT_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SYNC_PROFILE</key>
		<string>pre-market-auction-collect</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- 研究層資料收集，非下單層：每 60 秒觸發一次，實際 08:29-09:01 時間窗由 launcher 過濾 -->
	<key>StartInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/pre-market-auction-collect.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/pre-market-auction-collect.launchd.err.log</string>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
