#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · RRG mono 收盤前預警（13:00）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=1

mkdir -p "${ROOT}/logs/intraday"

WD="$(date '+%u')"
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi

echo ""
echo "=== launchd rrg-mono-intraday-watch 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
PYTHON="${ROOT}/.venv/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

set +e
OUT="$("${PYTHON}" "${ROOT}/scripts/run_rrg_mono_intraday_watch.py" 2>&1)"
EXIT=$?
set -e
echo "${OUT}"

echo "=== launchd rrg-mono-intraday-watch 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

/bin/bash "${ROOT}/scripts/launchd/supabase_slot_sync.sh" 1300 || true

STAMP="$(date '+%Y%m%d')"
EXTRA=""
for rel in \
  "reports/daily/${STAMP}_rrg_mono_intraday_watch.md" \
  "reports/daily/rrg_mono_intraday_watch.md"
do
  [[ -f "${ROOT}/${rel}" ]] && EXTRA+="${rel}"$'\n'
done
set +e
"${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
  --subject-prefix="RRG mono 收盤前預警" \
  --exit-code="${EXIT}" \
  --log-path="${ROOT}/logs/intraday/launchd_rrg-mono-intraday-watch.log" \
  --extra="${EXTRA}" \
  --env-flag="RUN_RRG_MONO_INTRADAY_EMAIL"
set -e

exit "${EXIT}"
