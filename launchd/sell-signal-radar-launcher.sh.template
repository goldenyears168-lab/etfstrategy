#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# Sell signal radar · 內嵌 Python（不 exec Documents 內 .command）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=0

mkdir -p "${ROOT}/logs/intraday"

WD="$(date '+%u')"
H=$((10#$(date '+%H')))
M=$((10#$(date '+%M')))
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi
if [[ "${H}" -lt 9 ]] || [[ "${H}" -gt 13 ]] || { [[ "${H}" -eq 13 ]] && [[ "${M}" -gt 20 ]]; }; then
  exit 0
fi
if [[ "${H}" -eq 9 && "${M}" -lt 6 ]]; then
  exit 0
fi

STAMP="$(date '+%Y%m%d')"
TICK_LOG="${ROOT}/logs/intraday/sell_signal_radar_${STAMP}.log"

echo ""
echo "=== launchd sell-signal-radar tick $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
export RUN_SELL_SIGNAL_RADAR="${RUN_SELL_SIGNAL_RADAR:-1}"
export RUN_SELL_SIGNAL_EMAIL="${RUN_SELL_SIGNAL_EMAIL:-1}"
export C18ACC_KBAR_SYNC="${C18ACC_KBAR_SYNC:-1}"
export C18ACC_EXTENSION_MODE="${C18ACC_EXTENSION_MODE:-combo_spike}"
export C18ACC_EXTENSION_MIN_SPIKE_PCT="${C18ACC_EXTENSION_MIN_SPIKE_PCT:-4}"
export C18ACC_EXTENSION_MIN_FADE_PCT="${C18ACC_EXTENSION_MIN_FADE_PCT:-1.0}"
export C18ACC_EXTENSION_POLL_MIN="${C18ACC_EXTENSION_POLL_MIN:-5}"
export SIGNAL_RADAR_SELL_HELD_ONLY="${SIGNAL_RADAR_SELL_HELD_ONLY:-1}"
export SIGNAL_RADAR_STRUCTURAL_EXIT="${SIGNAL_RADAR_STRUCTURAL_EXIT:-1}"
export SIGNAL_RADAR_S1A_VCP="${SIGNAL_RADAR_S1A_VCP:-1}"
export SIGNAL_RADAR_HOLDINGS_STRESS="${SIGNAL_RADAR_HOLDINGS_STRESS:-1}"
export SIGNAL_RADAR_S0_WATCH="${SIGNAL_RADAR_S0_WATCH:-1}"
export SIGNAL_RADAR_S0B_WATCH="${SIGNAL_RADAR_S0B_WATCH:-1}"
export SIGNAL_RADAR_UNIVERSE_MIN_HOLD_DAYS="${SIGNAL_RADAR_UNIVERSE_MIN_HOLD_DAYS:-0}"

PYTHON="${ROOT}/.venv/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

set +e
OUT="$("${PYTHON}" "${ROOT}/scripts/run_sell_signal_radar.py" 2>&1)"
EXIT=$?
set -e

{
  echo ""
  echo "=== launchd sell-signal-radar tick $(date '+%Y-%m-%d %H:%M:%S') ==="
  echo "${OUT}"
} >>"${TICK_LOG}"

if echo "${OUT}" | grep -q 'SELL_SIGNAL_RADAR=1'; then
  EXTRA_LINES="$(echo "${OUT}" | grep -E 'SELL_SIGNAL_RADAR|賣出|sell |trigger_' || true)"
  EXTRA=$'持倉賣出 advisory（extension / S1b·S2 · 人工確認）\n'"${EXTRA_LINES}"$'\n'
  for rel in "reports/daily/${STAMP}_sell_signal_radar.md" "reports/daily/sell_signal_radar.md"; do
    [[ -f "${ROOT}/${rel}" ]] && EXTRA+="${rel}"$'\n'
  done
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="Sell signal radar" \
    --exit-code="${EXIT}" \
    --log-path="${TICK_LOG}" \
    --extra="${EXTRA}" \
    --env-flag="RUN_SELL_SIGNAL_EMAIL"
  set -e
fi

END_LINE="=== launchd sell-signal-radar end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="
echo "${END_LINE}" >>"${TICK_LOG}"
echo "${END_LINE}"
exit "${EXIT}"
