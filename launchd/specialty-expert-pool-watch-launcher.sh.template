#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# 南電(8046)+金居(8358) 專家池 · 回看1日共識觀測 · 週一至五 20:05 · 達標才寄信
# 種子富邦新店已出局；監測 P5 真專家池 · 不下單
#
# Ops reference：expert_pool/MINI_OPS_REFERENCE.md（硬綠 L1H7 · 不買黃燈／軟共識）
# 可選黃燈註記（預設 OFF）：mini `.env` → EXPERT_POOL_YELLOW_EMAIL_ANNOTATION=1
#   或 CLI --yellow-annotation；仍非買訊。詳見 YELLOW_EMAIL_ANNOTATION.md

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
STAMP="$(date '+%Y%m%d')"
RUN_LOG="${ROOT}/logs/specialty_expert_pool_watch_${STAMP}.log"

mkdir -p "${ROOT}/logs"

echo ""
echo "=== launchd specialty-expert-pool-watch 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
PYTHON="${ROOT}/.venv/bin/python"

_load_env_file() {
  local path="$1"
  if [[ ! -r "${path}" ]]; then
    return 0
  fi
  set +e
  set -a
  # shellcheck disable=SC1090
  source "${path}" 2>/dev/null
  set +a
  set -e
}

_load_env_file "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/.env"

if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  EXIT=1
else
  set +e
  "${PYTHON}" "${ROOT}/scripts/research/run_specialty_expert_pool_watch.py" \
    --stock all \
    2>&1 | tee "${RUN_LOG}"
  EXIT=${PIPESTATUS[0]}
  set -e
fi

echo "=== launchd specialty-expert-pool-watch 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

if [[ "${EXIT}" -ne 0 && -x "${PYTHON}" ]]; then
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="南電/金居專家池觀測" \
    --exit-code="${EXIT}" \
    --log-path="${RUN_LOG}" \
    --extra="觀測失敗，詳見 log" \
    --env-flag="RUN_SPECIALTY_EXPERT_POOL_EMAIL"
  set -e
fi

exit "${EXIT}"
