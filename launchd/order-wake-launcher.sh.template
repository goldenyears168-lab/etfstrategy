#!/usr/bin/env bash
# 由 install-order-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# 盤中防休眠：鐘面每 5 分 · Mon–Fri 08:50–13:40 caffeinate

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
LOG_DIR="${HOME}/Library/Logs/com.jackm4.etf"
mkdir -p "${LOG_DIR}" "${ROOT}/logs"
LOG="${LOG_DIR}/order-wake.log"
# mirror for project greps
: >>"${ROOT}/logs/launchd_order-wake.log"

exec >>"${LOG}" 2>&1
echo "=== launchd order-wake $(date '+%Y-%m-%d %H:%M:%S') ==="
echo "=== launchd order-wake $(date '+%Y-%m-%d %H:%M:%S') ===" >>"${ROOT}/logs/launchd_order-wake.log"

WD="$(date '+%u')"
H=$((10#$(date '+%H')))
M=$((10#$(date '+%M')))

in_window=0
if [[ "${WD}" -le 5 ]]; then
  if [[ "${H}" -eq 8 && "${M}" -ge 50 ]]; then
    in_window=1
  elif [[ "${H}" -ge 9 && "${H}" -le 12 ]]; then
    in_window=1
  elif [[ "${H}" -eq 13 && "${M}" -le 40 ]]; then
    in_window=1
  fi
fi

if [[ "${in_window}" -ne 1 ]]; then
  echo "skip: outside market keep-awake window"
  echo "=== launchd order-wake 結束 ==="
  exit 0
fi

/usr/bin/caffeinate -dimsu -t 360 &
echo "caffeinate -dimsu -t 360 started pid=$!"
echo "=== launchd order-wake 結束 ==="
exit 0
