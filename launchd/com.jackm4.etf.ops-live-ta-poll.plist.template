<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.etf.ops-live-ta-poll</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{OPS_LIVE_TA_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- extras only · universe = holdings ∪ these；處置撮合見 OPS_LIVE_TA_DISPOSITION -->
		<key>OPS_LIVE_TA_STOCKS</key>
		<string>2492:華新科</string>
		<key>OPS_LIVE_TA_DISPOSITION</key>
		<string>2492</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- 週一至五 08:50 觸發一次；腳本 --loop 跑到 13:35（一登入＋進程內 TTL） -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>8</integer>
			<key>Minute</key>
			<integer>50</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>2</integer>
			<key>Hour</key>
			<integer>8</integer>
			<key>Minute</key>
			<integer>50</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>3</integer>
			<key>Hour</key>
			<integer>8</integer>
			<key>Minute</key>
			<integer>50</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>8</integer>
			<key>Minute</key>
			<integer>50</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>5</integer>
			<key>Hour</key>
			<integer>8</integer>
			<key>Minute</key>
			<integer>50</integer>
		</dict>
	</array>
	<!-- bootout 時等待長駐行程結束 -->
	<key>ExitTimeOut</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.etf/ops-live-ta-poll.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.etf/ops-live-ta-poll.launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
