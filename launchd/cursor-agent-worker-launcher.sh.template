#!/usr/bin/env bash
# Cursor My Machines worker（僅 Mac mini）
# 由 install-cursor-agent-worker-launchd.sh 安裝至
# ~/Library/Application Support/com.jackm4.etf/cursor-agent-worker.sh
#
# 閘門：.env CURSOR_AGENT_WORKER_ENABLED=1
# 認證：Aqua session `agent login`，或 .env CURSOR_API_KEY
# 名稱：CURSOR_AGENT_WORKER_NAME（預設 mac-mini）
# 目錄：CURSOR_AGENT_WORKER_DIR（預設 $HOME/etf-stocks → 指向中文路徑的 ASCII symlink）
#       Cursor exec-daemon 無法吃非 Latin-1 路徑（股票研究），必須走 symlink。

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
LOG_DIR="${HOME}/Library/Logs/com.jackm4.etf"
mkdir -p "${LOG_DIR}" "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs"
LOG="${LOG_DIR}/cursor-agent-worker.log"
: >>"${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/launchd_cursor-agent-worker.log"

exec >>"${LOG}" 2>&1
echo "=== launchd cursor-agent-worker $(date '+%Y-%m-%d %H:%M:%S') ==="

export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH}"

if [[ -f "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/.env"
  set +a
fi

ENABLED="${CURSOR_AGENT_WORKER_ENABLED:-0}"
if [[ "${ENABLED}" != "1" ]]; then
  echo "skip: CURSOR_AGENT_WORKER_ENABLED!=1"
  exit 0
fi

AGENT_BIN="$(command -v agent || true)"
if [[ -z "${AGENT_BIN}" ]]; then
  echo "✗ agent CLI not found (install: curl https://cursor.com/install -fsS | bash)" >&2
  exit 1
fi

NAME="${CURSOR_AGENT_WORKER_NAME:-mac-mini}"
# Prefer ASCII symlink; fall back to explicit env, then ROOT
WORKER_DIR="${CURSOR_AGENT_WORKER_DIR:-}"
if [[ -z "${WORKER_DIR}" && -d "${HOME}/etf-stocks" ]]; then
  WORKER_DIR="${HOME}/etf-stocks"
fi
if [[ -z "${WORKER_DIR}" ]]; then
  WORKER_DIR="${ROOT}"
fi

cd "${WORKER_DIR}"

echo "starting: agent worker start --name ${NAME} --worker-dir ${WORKER_DIR}"
echo "=== launchd cursor-agent-worker $(date '+%Y-%m-%d %H:%M:%S') ===" \
  >>"${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/launchd_cursor-agent-worker.log"

args=(worker start --name "${NAME}" --worker-dir "${WORKER_DIR}")
if [[ -n "${CURSOR_API_KEY:-}" ]]; then
  args+=(--api-key "${CURSOR_API_KEY}")
fi
exec "${AGENT_BIN}" "${args[@]}"
