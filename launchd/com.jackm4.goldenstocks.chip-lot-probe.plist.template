<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.chip-lot-probe</string>
	<!-- 週一至五 12:50 · 盤中單量結構探針（一次性，13:35 自動退出）· 唯讀、不下單。
	     第三條 Fubon 行情 websocket，訂閱預算 45×1；驗證「盤中判別大戶集中買」，
	     與 22:15 chip-loud-accum-track 的家數差對照。刻意不進 install-launchd.sh
	     的 LABELS（比照 futopt-books-collect-stocks），安裝方式見
	     scripts/launchd/chip-lot-probe.command 檔頭。 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{CHIP_LOT_PROBE_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>50</integer></dict>
		<dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>50</integer></dict>
		<dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>50</integer></dict>
		<dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>50</integer></dict>
		<dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>50</integer></dict>
	</array>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/chip-lot-probe.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/chip-lot-probe.launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
