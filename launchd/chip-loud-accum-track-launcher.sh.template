#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.goldenstocks/
# 週一至五 22:15 · 高調吸貨前瞻紀錄（chip-loud-accum-forward）· 唯讀研究 · 不下單
#
# 開關：.env 的 RUN_CHIP_LOUD_ACCUM_TRACK（預設 1）
# 凍結規格見 config/research.yaml topic chip-loud-accum-forward；60 個訊號日後結算。
# 休市日由腳本自行判斷（當日無日線→靜默跳過）；FinMind 未出當日分點→留待下次補。

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
STAMP="$(date '+%Y%m%d')"
DATA_DIR="${GOLDENSTOCKS_DATA_DIR:-${ROOT}}"
RUN_LOG="${DATA_DIR}/logs/chip_loud_accum_track_${STAMP}.log"
LOCK_DIR="${DATA_DIR}/logs/.chip-loud-accum-track.lock"

mkdir -p "${DATA_DIR}/logs"

_load_env_file() {
  [[ -r "$1" ]] || return 0
  set +e; set -a
  # shellcheck disable=SC1090
  source "$1" 2>/dev/null
  set +a; set -e
}
_load_env_file "${DATA_DIR}/.env"

if [[ "${RUN_CHIP_LOUD_ACCUM_TRACK:-1}" == "0" ]]; then
  echo "chip-loud-accum-track skipped: RUN_CHIP_LOUD_ACCUM_TRACK=0"
  exit 0
fi

# 抓數要打 FinMind 幾分鐘；重疊執行只會互相 rate-limit。
if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
  echo "chip-loud-accum-track skipped: 另一輪仍在執行（${LOCK_DIR}）"
  exit 0
fi
trap 'rmdir "${LOCK_DIR}" 2>/dev/null || true' EXIT

echo "=== chip loud-accum forward track 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export PYTHONPATH="${ROOT}/src"
PYTHON="${ROOT}/.venv/bin/python"

EXIT=0
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  EXIT=1
else
  set +e
  "${PYTHON}" "${ROOT}/scripts/research/chip_loud_accum_forward_track.py" \
    2>&1 | tee "${RUN_LOG}"
  EXIT=${PIPESTATUS[0]}
  set -e
fi

echo "=== chip loud-accum forward track 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

if [[ "${EXIT}" -ne 0 && -x "${PYTHON}" ]]; then
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="高調吸貨前瞻紀錄" \
    --exit-code="${EXIT}" \
    --log-path="${RUN_LOG}" \
    --extra="chip-loud-accum-track 失敗，今日前瞻紀錄缺口，詳見 log"
  set -e
fi

exit "${EXIT}"
