#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.goldenstocks/
# TMF micro-channel Order · long-lived worker（KeepAlive）· 重用 Fubon session
# 日盤 08:45–13:45 + 夜盤 15:00–05:00（窗外 worker 內 sleep，不重登入）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
APP_SUPPORT="{{APP_SUPPORT}}"

mkdir -p "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/intraday" "${APP_SUPPORT}"
mkdir -p "${HOME}/Library/Logs/com.jackm4.goldenstocks"

export TZ="${TZ:-Asia/Taipei}"
export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"

WORKER_PY="${ROOT}/scripts/order/run_tmf_channel_worker.py"

# --- 反重跑：PID 存活判定，不用時間老化 -------------------------------------
# 2026-08-17 事故：舊版把 lockdir 超過 120s 就當 stale 直接 rm -rf。這條規則是
# StartInterval 冷啟動時代寫的（每輪幾秒就結束），架構改成 KeepAlive 常駐
# worker 之後，鎖在開工兩分鐘後就自動失效 —— 等於沒有鎖。實際後果：
# `launchctl kickstart -k` 只殺得掉 launcher shell，卡死在 Python 迴圈裡的
# worker 收到 SIGTERM 也只是把 _STOP 旗標設起來（永遠不會被檢查到），於是
# 舊 worker 續活、新 worker 照樣起來，同時有兩個 worker 對同一個帳戶對帳
# ——正是 CLAUDE.md「禁止雙跑」要擋的情境，卻被鎖自己放行。
# 改法：鎖裡存 PID，用 kill -0 判定是否真的還活著；真的活著就退出（維持
# 單一執行路徑），確定是殘骸才清掉。另外主動收殘留的 worker 行程，避免
# kickstart -k 殺不乾淨的漏網之魚。
LOCKDIR="${APP_SUPPORT}/tmf-channel-poll.lockdir"
if ! mkdir "${LOCKDIR}" 2>/dev/null; then
  holder="$(cat "${LOCKDIR}/pid" 2>/dev/null || echo "")"
  if [[ -n "${holder}" ]] && kill -0 "${holder}" 2>/dev/null; then
    echo "skip: tmf-channel worker already holding lock (pid=${holder}, alive)"
    exit 0
  fi
  echo "reclaiming stale lock (holder=${holder:-unknown} not alive)"
  rm -rf "${LOCKDIR}"
  if ! mkdir "${LOCKDIR}" 2>/dev/null; then
    echo "skip: tmf-channel worker lock race lost"
    exit 0
  fi
fi
echo "$$" > "${LOCKDIR}/pid"
trap 'rm -rf "${LOCKDIR}" 2>/dev/null || true' EXIT

# 收殘骸：任何不是自己的 run_tmf_channel_worker.py（含卡死不理 SIGTERM 的）
for stale in $(pgrep -f "${WORKER_PY}" 2>/dev/null || true); do
  [[ "${stale}" == "$$" ]] && continue
  echo "reaping stale tmf worker pid=${stale}"
  kill -TERM "${stale}" 2>/dev/null || true
done
sleep 2
for stale in $(pgrep -f "${WORKER_PY}" 2>/dev/null || true); do
  [[ "${stale}" == "$$" ]] && continue
  echo "stale tmf worker pid=${stale} ignored SIGTERM → SIGKILL"
  kill -KILL "${stale}" 2>/dev/null || true
done

STAMP="$(date '+%Y%m%d')"
TICK_LOG="${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/intraday/tmf_channel_live_${STAMP}.log"

_load_env_file() {
  local path="$1"
  local label="$2"
  if [[ ! -r "${path}" ]]; then
    return 0
  fi
  set +e
  set -a
  # shellcheck disable=SC1090
  source "${path}" 2>/dev/null
  local rc=$?
  set +a
  set -e
  if [[ "${rc}" -ne 0 ]]; then
    echo "WARN: cannot source ${label} (${path}) rc=${rc} · continue with defaults"
  fi
}

_load_env_file "${APP_SUPPORT}/order.env" "order.env"
_load_env_file "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/.env" "project .env"

export ORDER_TMF_CHANNEL_ENABLED="${ORDER_TMF_CHANNEL_ENABLED:-0}"
export ORDER_TMF_CHANNEL_DRY_RUN="${ORDER_TMF_CHANNEL_DRY_RUN:-1}"
export ORDER_TMF_CHANNEL_AUTO_SUBMIT="${ORDER_TMF_CHANNEL_AUTO_SUBMIT:-0}"
export ORDER_TMF_CHANNEL_WORKER_INTERVAL="${ORDER_TMF_CHANNEL_WORKER_INTERVAL:-20}"
export ORDER_TMF_CHANNEL_WORKER_IDLE="${ORDER_TMF_CHANNEL_WORKER_IDLE:-60}"

export ORDER_TMF_CHANNEL_RECONCILE_WATCHDOG_SEC="${ORDER_TMF_CHANNEL_RECONCILE_WATCHDOG_SEC:-120}"

PYTHON="${ROOT}/.venv-fubon/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing .venv-fubon python: ${PYTHON}"
  exit 1
fi

echo "=== launchd tmf-channel-poll WORKER start $(date '+%Y-%m-%d %H:%M:%S') ===" | tee -a "${TICK_LOG}"

set +e
"${PYTHON}" "${ROOT}/scripts/order/run_tmf_channel_worker.py" 2>&1 | tee -a "${TICK_LOG}"
EXIT=${PIPESTATUS[0]}
set -e

echo "=== launchd tmf-channel-poll WORKER end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ===" | tee -a "${TICK_LOG}"
exit "${EXIT}"
