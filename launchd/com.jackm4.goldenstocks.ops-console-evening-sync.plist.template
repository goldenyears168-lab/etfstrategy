<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.ops-console-evening-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{OPS_CONSOLE_EVENING_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONPATH</key>
		<string>{{PROJECT_ROOT}}/src</string>
		<key>RUN_OPS_DIGEST_SYNC</key>
		<string>1</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key><integer>1</integer>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>40</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>2</integer>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>40</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>3</integer>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>40</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>4</integer>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>40</integer>
		</dict>
		<dict>
			<key>Weekday</key><integer>5</integer>
			<key>Hour</key><integer>20</integer>
			<key>Minute</key><integer>40</integer>
		</dict>
	</array>
	<!-- launchd Std 路徑必須放 ~/Library/Logs（非 TCC 保護區）；放在 {{PROJECT_ROOT}}
	     （~/Documents 下）會讓 launchd 開檔被 TCC 拒絕 → spawn 前 EX_CONFIG(78)、零輸出。 -->
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/ops-console-evening-sync.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/ops-console-evening-sync.launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
