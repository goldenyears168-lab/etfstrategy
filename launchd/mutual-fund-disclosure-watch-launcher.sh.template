#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · 安聯台灣科技基金月報偵測 · 16:30

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
STAMP="$(date '+%Y%m%d')"
RUN_LOG="${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/mutual_fund_disclosure_watch_${STAMP}.log"

echo ""
echo "=== launchd mutual-fund-disclosure-watch 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
PYTHON="${ROOT}/.venv/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  EXIT=1
  NOTIFY_EXTRA="venv 不存在"
else
  set +e
  "${PYTHON}" "${ROOT}/scripts/run_mutual_fund_disclosure_watch.py" 2>&1 | tee "${RUN_LOG}"
  EXIT=${PIPESTATUS[0]}
  set -e
  NOTIFY_EXTRA=""
fi

echo "=== launchd mutual-fund-disclosure-watch 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

if [[ "${EXIT}" -ne 0 && -x "${PYTHON}" ]]; then
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="安聯台灣科技基金月報偵測" \
    --exit-code="${EXIT}" \
    --log-path="${RUN_LOG}" \
    --extra="${NOTIFY_EXTRA:-偵測失敗，詳見 log}" \
    --env-flag="RUN_MUTUAL_FUND_DISCLOSURE_EMAIL"
  set -e
fi

exit "${EXIT}"
