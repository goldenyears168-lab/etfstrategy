#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# 華邦電專家池共識觀測 · 週一至五 20:00 · 達標才寄信

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
STAMP="$(date '+%Y%m%d')"
RUN_LOG="${ROOT}/logs/winbond_expert_pool_watch_${STAMP}.log"

mkdir -p "${ROOT}/logs"

echo ""
echo "=== launchd winbond-expert-pool-watch 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
PYTHON="${ROOT}/.venv/bin/python"

_load_env_file() {
  local path="$1"
  if [[ ! -r "${path}" ]]; then
    return 0
  fi
  set +e
  set -a
  # shellcheck disable=SC1090
  source "${path}" 2>/dev/null
  set +a
  set -e
}

_load_env_file "${ROOT}/.env"

if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  EXIT=1
else
  set +e
  "${PYTHON}" "${ROOT}/scripts/research/run_winbond_expert_pool_watch.py" \
    2>&1 | tee "${RUN_LOG}"
  EXIT=${PIPESTATUS[0]}
  set -e
fi

echo "=== launchd winbond-expert-pool-watch 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

# 僅失敗時寄失敗信；達標信由 Python send_alert 直接寄
if [[ "${EXIT}" -ne 0 && -x "${PYTHON}" ]]; then
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="華邦電專家池觀測" \
    --exit-code="${EXIT}" \
    --log-path="${RUN_LOG}" \
    --extra="觀測失敗，詳見 log" \
    --env-flag="RUN_WINBOND_EXPERT_POOL_EMAIL"
  set -e
fi

exit "${EXIT}"
