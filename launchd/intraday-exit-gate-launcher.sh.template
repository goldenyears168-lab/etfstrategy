#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# 09:06 組合閘門 · 內嵌 Python（不 exec Documents 內 .command）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=0

mkdir -p "${ROOT}/logs/intraday"

WD="$(date '+%u')"
H=$((10#$(date '+%H')))
M=$((10#$(date '+%M')))
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi
if [[ "${H}" -ne 9 ]]; then
  exit 0
fi
case "${M}" in
  6|10|12|15) ;;
  *) exit 0 ;;
esac

echo ""
echo "=== launchd intraday-exit-gate $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
export RUN_INTRADAY_EXIT_GATE_EMAIL="${RUN_INTRADAY_EXIT_GATE_EMAIL:-1}"
export INTRADAY_GATE_KBAR_SYNC="${INTRADAY_GATE_KBAR_SYNC:-1}"

PYTHON="${ROOT}/.venv/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

STAMP="$(date '+%Y%m%d')"

set +e
OUT="$("${PYTHON}" "${ROOT}/scripts/order/run_intraday_exit_gate.py" \
  --write --persist --notify 2>&1)"
EXIT=$?
set -e
echo "${OUT}"

echo "=== launchd intraday-exit-gate end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="
exit "${EXIT}"
