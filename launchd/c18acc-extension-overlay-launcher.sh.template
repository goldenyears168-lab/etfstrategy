#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · C18acc extension overlay 獨立盤程

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"

WD="$(date '+%u')"
H=$((10#$(date '+%H')))
M=$((10#$(date '+%M')))
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi
if [[ "${H}" -lt 9 ]] || [[ "${H}" -gt 13 ]] || { [[ "${H}" -eq 13 ]] && [[ "${M}" -gt 20 ]]; }; then
  exit 0
fi
if [[ "${H}" -eq 9 && "${M}" -lt 6 ]]; then
  exit 0
fi

exec /bin/bash "{{PROJECT_ROOT}}/scripts/launchd/c18acc-extension-overlay.command"
