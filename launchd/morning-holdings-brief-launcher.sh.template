#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · Morning holdings brief · 08:50

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=0

mkdir -p "${ROOT}/logs/intraday"

WD="$(date '+%u')"
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi

echo "=== launchd morning-holdings-brief $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
export RUN_MORNING_HOLDINGS_EMAIL="${RUN_MORNING_HOLDINGS_EMAIL:-0}"

PYTHON="${ROOT}/.venv-fubon/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

NOTIFY_ARGS=()
if [[ "${RUN_MORNING_HOLDINGS_EMAIL}" == "1" ]]; then
  NOTIFY_ARGS=(--notify)
fi

EXIT=1
for attempt in 1 2 3; do
  set +e
  if ((${#NOTIFY_ARGS[@]})); then
    OUT="$("${PYTHON}" "${ROOT}/scripts/order/morning_holdings_brief.py" \
      --sync-futures --sync-db --write --notify 2>&1)"
  else
    OUT="$("${PYTHON}" "${ROOT}/scripts/order/morning_holdings_brief.py" \
      --sync-futures --sync-db --write 2>&1)"
  fi
  EXIT=$?
  set -e
  echo "${OUT}"
  if [[ "${EXIT}" -eq 0 ]]; then
    break
  fi
  if echo "${OUT}" | grep -qE 'IO error|nodename nor servname|Network is unreachable'; then
    echo "WARN: fubon/network retry ${attempt}/3 …"
    sleep 15
  else
    break
  fi
done

echo "=== launchd morning-holdings-brief end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="
exit "${EXIT}"
