<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.chip-loud-accum-track</string>
	<!-- 週一至五 22:15 · 高調吸貨前瞻紀錄（topic chip-loud-accum-forward · 凍結規格 2026-08-28）。
	     抓全宇宙分點日報（FinMind ~950 req）→ 買賣兩側各 30 檔寫 DB 表
	     chip_loud_accum_forward → 回填到期 outcome。唯讀研究、不下單、不寄名單信
	     （失敗才通知）。為何 22:15：branch-tape-prewarm 18:30 已證 FinMind 同日
	     分點傍晚可得；22:15 錯開 21:00 chip-daily-brief 的 TWSE 補檔與 quota。 -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{CHIP_LOUD_ACCUM_TRACK_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>PYTHONPATH</key>
		<string>{{PROJECT_ROOT}}/src</string>
	</dict>
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>15</integer></dict>
		<dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>22</integer><key>Minute</key><integer>15</integer></dict>
	</array>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/chip-loud-accum-track.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/chip-loud-accum-track.launchd.err.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
