#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.goldenstocks/
#
# 一次性任務：08:45 開盤平掉華新科期貨 HBFI6（096，到期 202609）多單 2 口。
# 個股期貨只有日盤（08:45-13:45），本合約無夜盤（實測行情最後更新停在日盤收盤）。
#
# **dry-run-first**：本 launcher 不改任何旗標。要真的送單，使用者必須在
# ${GOLDENSTOCKS_DATA_DIR}/.env 設 ORDER_CLOSE_FUTOPT_LIVE=1（雙鎖之一）；
# 腳本的 --live 由本 launcher 帶入，但缺那個環境變數仍然只會乾跑。
#
# 平倉完成後請退役本 job：從 install-launchd.sh 的 LABELS/TEMPLATES 移除、
# 加進 RETIRED_LABELS，並更新 config/job_registry.yaml。

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
APP_SUPPORT="{{APP_SUPPORT}}"
DATA_DIR="${GOLDENSTOCKS_DATA_DIR:-${ROOT}}"

mkdir -p "${DATA_DIR}/logs/intraday" "${APP_SUPPORT}"
mkdir -p "${HOME}/Library/Logs/com.jackm4.goldenstocks"
export TZ="${TZ:-Asia/Taipei}"
export PYTHONPATH="${ROOT}/src"

# shellcheck disable=SC1091
if [[ -f "${DATA_DIR}/.env" ]]; then
  set -a
  source "${DATA_DIR}/.env"
  set +a
fi

STAMP="$(date '+%Y%m%d')"
LOG="${DATA_DIR}/logs/intraday/close_hbf_position_${STAMP}.log"

# 一次性任務的自我限制：只在指定日執行。若忘了退役，之後每天 08:45 醒來也會
# 立刻退出，不會查帳、不會登入、更不會送單。要改期就改這一行。
ONLY_ON="${CLOSE_HBF_ONLY_ON:-20260821}"
if [[ "${STAMP}" != "${ONLY_ON}" ]]; then
  echo "$(date '+%F %T') skip: today=${STAMP} != ONLY_ON=${ONLY_ON}" >> "${LOG}"
  exit 0
fi

# 價格方式可用 .env 覆寫，不必重裝 launchd
PRICE_TYPE="${CLOSE_HBF_PRICE_TYPE:-market}"
TIF="${CLOSE_HBF_TIF:-ioc}"
PRICE_ARG=()
if [[ "${PRICE_TYPE}" == "limit" && -n "${CLOSE_HBF_PRICE:-}" ]]; then
  PRICE_ARG=(--price "${CLOSE_HBF_PRICE}")
fi

{
  echo "=== $(date '+%F %T') close-hbf-position 觸發 ==="
  echo "price_type=${PRICE_TYPE} tif=${TIF} live_env=${ORDER_CLOSE_FUTOPT_LIVE:-unset}"
  "${ROOT}/.venv-fubon/bin/python" "${ROOT}/scripts/order/close_futopt_position.py" \
    --acct-symbol FIHBF \
    --trade-symbol HBFI6 \
    --expect-side Buy \
    --expect-lots 2 \
    --expect-expiry 202609 \
    --price-type "${PRICE_TYPE}" \
    --tif "${TIF}" \
    "${PRICE_ARG[@]}" \
    --session-window 08:45-13:40 \
    --lockdir "${APP_SUPPORT}/close-hbf-position-${STAMP}.lockdir" \
    --live
} >> "${LOG}" 2>&1
