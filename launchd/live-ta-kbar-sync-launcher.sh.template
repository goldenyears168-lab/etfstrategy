#!/usr/bin/env bash
# 由手動安裝至 ~/Library/Application Support/com.jackm4.etf/
# 週一至五 14:00 · Live TA 動態 universe（持股∪關注清單）stock_kbar_1m 每日增補
# （FinMind TaiwanStockKBar，僅補近15個交易日缺口）· 不下單
#
# 方法／驗證依據見腳本 docstring：
#   scripts/sync_live_ta_universe_kbar_daily.py
#   reports/research/intraday_direction_thermometer/LIVE_TA_FIELD_OPTIMIZATION_20260728.md

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
STAMP="$(date '+%Y%m%d')"
RUN_LOG="${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/live_ta_kbar_sync_${STAMP}.log"

mkdir -p "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs"

echo ""
echo "=== launchd live-ta-kbar-sync 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export PYTHONPATH="${ROOT}/src"

_load_env_file() {
  local path="$1"
  if [[ ! -r "${path}" ]]; then
    return 0
  fi
  set +e
  set -a
  # shellcheck disable=SC1090
  source "${path}" 2>/dev/null
  set +a
  set -e
}

_load_env_file "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/.env"

PYTHON="${ROOT}/.venv/bin/python"

EXIT=0
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  EXIT=1
else
  set +e
  "${PYTHON}" "${ROOT}/scripts/sync_live_ta_universe_kbar_daily.py" \
    2>&1 | tee -a "${RUN_LOG}"
  EXIT=${PIPESTATUS[0]}
  set -e
fi

echo "=== launchd live-ta-kbar-sync 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="
exit "${EXIT}"
