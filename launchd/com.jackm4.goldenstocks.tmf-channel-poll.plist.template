<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.tmf-channel-poll</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{TMF_CHANNEL_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SYNC_PROFILE</key>
		<string>tmf-channel-poll</string>
		<key>GOLDENSTOCKS_DATA_DIR</key>
		<string>/Users/jackm4/goldenstocks-data</string>
		<key>TZ</key>
		<string>Asia/Taipei</string>
		<!-- Fail-closed defaults only. launcher sources GOLDENSTOCKS_DATA_DIR/.env -->
		<key>ORDER_TMF_CHANNEL_ENABLED</key>
		<string>0</string>
		<key>ORDER_TMF_CHANNEL_DRY_RUN</key>
		<string>1</string>
		<key>ORDER_TMF_CHANNEL_AUTO_SUBMIT</key>
		<string>0</string>
		<key>ORDER_TMF_CHANNEL_WORKER_INTERVAL</key>
		<string>20</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- Long-lived worker: KeepAlive（內部 sleep 對帳）；勿再用 StartInterval 冷登入 -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/tmf-channel-poll.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/tmf-channel-poll.launchd.err.log</string>
</dict>
</plist>
