#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# Buy signal radar · 內嵌 Python（不 exec Documents 內 .command）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=0

mkdir -p "${ROOT}/logs/intraday"

WD="$(date '+%u')"
H=$((10#$(date '+%H')))
M=$((10#$(date '+%M')))
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi
if [[ "${H}" -lt 9 ]] || [[ "${H}" -gt 13 ]] || { [[ "${H}" -eq 13 ]] && [[ "${M}" -gt 20 ]]; }; then
  exit 0
fi

STAMP="$(date '+%Y%m%d')"
TICK_LOG="${ROOT}/logs/intraday/buy_signal_radar_${STAMP}.log"

echo ""
echo "=== launchd buy-signal-radar tick $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
export RUN_BUY_SIGNAL_RADAR="${RUN_BUY_SIGNAL_RADAR:-1}"
export RUN_BUY_SIGNAL_EMAIL="${RUN_BUY_SIGNAL_EMAIL:-1}"
export C18ACC_KBAR_SYNC="${C18ACC_KBAR_SYNC:-1}"
export SIGNAL_RADAR_USE_FUBON="${SIGNAL_RADAR_USE_FUBON:-1}"

PYTHON="${ROOT}/.venv/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

set +e
OUT="$("${PYTHON}" "${ROOT}/scripts/run_buy_signal_radar.py" 2>&1)"
EXIT=$?
set -e

{
  echo ""
  echo "=== launchd buy-signal-radar tick $(date '+%Y-%m-%d %H:%M:%S') ==="
  echo "${OUT}"
} >>"${TICK_LOG}"

if echo "${OUT}" | grep -q 'BUY_SIGNAL_RADAR=1'; then
  # 寄信正文：C0 買進 + observe 命中 + ABC v3 skip09/f1 池標題與 top 列（· v3 / · f1）
  EXTRA_LINES="$(echo "${OUT}" | grep -E \
    'BUY_SIGNAL_RADAR|買進|觀測命中|多軌重疊|▸ ABC v3|· v3|· f1|buy ' || true)"
  EXTRA=$'買進 / ABC v3·f1 observe 命中（advisory · 人工確認）\n'"${EXTRA_LINES}"$'\n'
  for rel in "reports/daily/${STAMP}_buy_signal_radar.md" "reports/daily/buy_signal_radar.md"; do
    [[ -f "${ROOT}/${rel}" ]] && EXTRA+="${rel}"$'\n'
  done
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="Buy signal radar" \
    --exit-code="${EXIT}" \
    --log-path="${TICK_LOG}" \
    --extra="${EXTRA}" \
    --env-flag="RUN_BUY_SIGNAL_EMAIL"
  set -e
fi

END_LINE="=== launchd buy-signal-radar end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="
echo "${END_LINE}" >>"${TICK_LOG}"
echo "${END_LINE}"
exit "${EXIT}"
