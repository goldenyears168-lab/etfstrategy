#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · Minervini SEPA basket · 16:35

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=1
OUT=""

echo ""
echo "=== launchd minervini-sepa-basket $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
export ORDER_MINERVINI_SEPA_DRY_RUN="${ORDER_MINERVINI_SEPA_DRY_RUN:-1}"
PYTHON="${ROOT}/.venv/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  EXIT=1
else
  set +e
  OUT="$("${PYTHON}" "${ROOT}/scripts/run_minervini_sepa_daily_brief.py" 2>&1)"
  EXIT=$?
  set -e
  echo "${OUT}"
fi

echo "=== launchd minervini-sepa-basket end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

if echo "${OUT}" | grep -q 'MINERVINI_SEPA_SIGNAL=1' && [[ -x "${PYTHON}" ]]; then
  STAMP="$(date '+%Y%m%d')"
  EXTRA_LINES="$(echo "${OUT}" | grep -E 'MINERVINI_SEPA_SIGNAL|rebalance:' || true)"
  EXTRA=$'本輪月末調倉（dry-run intent）\n'"${EXTRA_LINES}"$'\n'
  for rel in \
    "reports/daily/${STAMP}_minervini_sepa_basket_daily.md" \
    "reports/daily/minervini_sepa_basket_daily.md" \
    "reports/order/intents/minervini-sepa-basket_$(date '+%Y-%m-%d').json"
  do
    [[ -f "${ROOT}/${rel}" ]] && EXTRA+="${rel}"$'\n'
  done
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="Minervini SEPA basket" \
    --exit-code="${EXIT}" \
    --log-path="${ROOT}/logs/launchd_minervini-sepa-basket.log" \
    --extra="${EXTRA}" \
    --env-flag="RUN_MINERVINI_SEPA_EMAIL"
  set -e
fi

exit "${EXIT}"
