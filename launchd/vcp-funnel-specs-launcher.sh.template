#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · VCP Pivot Gate / Coil Close 盤中 brief（13:00）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=1

mkdir -p "${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/intraday"

WD="$(date '+%u')"
if [[ "${WD}" -gt 5 ]]; then
  exit 0
fi

echo ""
echo "=== launchd vcp-funnel-specs 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
PYTHON="${ROOT}/.venv/bin/python"

if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

set +e
OUT="$("${PYTHON}" "${ROOT}/scripts/run_vcp_funnel_intraday.py" 2>&1)"
EXIT=$?
set -e
echo "${OUT}"

echo "=== launchd vcp-funnel-specs 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

/bin/bash "${ROOT}/scripts/launchd/supabase_slot_sync.sh" 1300 || true

STAMP="$(date '+%Y%m%d')"
EXTRA=""
for rel in \
  "reports/daily/${STAMP}_vcp_funnel_specs_daily_brief.md" \
  "reports/daily/vcp_funnel_specs_daily_brief.md" \
  "reports/daily/${STAMP}_vcp_pivot_gate_daily_brief.md" \
  "reports/daily/vcp_pivot_gate_daily_brief.md" \
  "reports/daily/${STAMP}_vcp_coil_close_daily_brief.md" \
  "reports/daily/vcp_coil_close_daily_brief.md"
do
  [[ -f "${ROOT}/${rel}" ]] && EXTRA+="${rel}"$'\n'
done
set +e
"${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
  --subject-prefix="VCP Pivot Gate / Coil Close" \
  --exit-code="${EXIT}" \
  --log-path="${GOLDENSTOCKS_DATA_DIR:-${ROOT}}/logs/intraday/launchd_vcp-funnel-specs.log" \
  --extra="${EXTRA}" \
  --env-flag="RUN_VCP_FUNNEL_SPECS_EMAIL"
set -e

exit "${EXIT}"
