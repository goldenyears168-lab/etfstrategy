#!/usr/bin/env bash
# 由 install-launchd.sh 安裝至 ~/Library/Application Support/com.jackm4.etf/
# 背景執行 C18acc poll（不開 Terminal；launchd 無法 exec Documents 內 .command/.sh）

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"
EXIT=0

mkdir -p "${ROOT}/logs"

echo ""
echo "=== launchd rrg-c18acc-poll tick $(date '+%Y-%m-%d %H:%M:%S') ==="

WD="$(date '+%u')"
H=$((10#$(date '+%H')))
M=$((10#$(date '+%M')))
if [[ "${WD}" -gt 5 ]]; then
  echo "skip: weekend"
  exit 0
fi
if [[ "${H}" -lt 9 ]] || [[ "${H}" -gt 13 ]] || { [[ "${H}" -eq 13 ]] && [[ "${M}" -gt 30 ]]; }; then
  echo "skip: outside 09:00–13:30"
  exit 0
fi

export ROOT="${ROOT}"
export PYTHONPATH="${ROOT}/src"
export RUN_RRG_C18ACC_SCREEN="${RUN_RRG_C18ACC_SCREEN:-1}"
export ORDER_C18ACC_DRY_RUN="${ORDER_C18ACC_DRY_RUN:-1}"
export ORDER_C18ACC_APPLY_STATE="${ORDER_C18ACC_APPLY_STATE:-1}"
export C18ACC_KBAR_SYNC="${C18ACC_KBAR_SYNC:-1}"
export RUN_RRG_C18ACC_EMAIL="${RUN_RRG_C18ACC_EMAIL:-1}"
export C18ACC_POOL_OVERRIDE="${C18ACC_POOL_OVERRIDE:-3711,6488,2344,3008}"
export C18ACC_POOL_OVERRIDE_DATE="${C18ACC_POOL_OVERRIDE_DATE:-$(date +%Y-%m-%d)}"

PYTHON="${ROOT}/.venv/bin/python"
if [[ ! -x "${PYTHON}" ]]; then
  echo "✗ missing venv python: ${PYTHON}"
  exit 1
fi

set +e
OUT="$("${PYTHON}" "${ROOT}/scripts/run_rrg_mono_swap_accel_screen.py" 2>&1)"
EXIT=$?
set -e
echo "${OUT}"

if echo "${OUT}" | grep -q 'C18ACC_SIGNAL=1'; then
  EXTRA_LINES="$(echo "${OUT}" | grep -E 'C18acc (screen|intent)|C18ACC_SIGNAL' || true)"
  STAMP="$(date '+%Y%m%d')"
  EXTRA="${JOB_NOTIFY_EXTRA:-$'本輪觸發動作（dry-run intent）\n'"${EXTRA_LINES}"$'\n'}"
  LAUNCHD_LOG="${ROOT}/logs/launchd_rrg-c18acc-poll.log"
  for rel in \
    "reports/daily/${STAMP}_rrg_c18acc_screen.md" \
    "reports/daily/rrg_c18acc_screen.md" \
    "logs/rrg_c18acc_poll_tick.log"; do
    [[ -f "${ROOT}/${rel}" ]] && EXTRA+="${rel}"$'\n'
  done
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="C18acc 盤中訊號" \
    --exit-code="${EXIT}" \
    --log-path="${LAUNCHD_LOG}" \
    --extra="${EXTRA}" \
    --env-flag="RUN_RRG_C18ACC_EMAIL"
  set -e
fi

echo "=== launchd rrg-c18acc-poll end exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="
exit "${EXIT}"
