#!/usr/bin/env bash
# 由 install-launchd.sh 安裝 · 週日深度補庫 · 20:00

set -euo pipefail

ROOT="{{PROJECT_ROOT}}"

echo ""
echo "=== launchd weekly-deep 開始 $(date '+%Y-%m-%d %H:%M:%S') ==="

export SYNC_PROFILE="weekly-deep"
set +e
/bin/bash "${ROOT}/scripts/weekly_sync.sh" --weekly-report
EXIT=$?
set -e

echo "=== launchd weekly-deep 結束 exit=${EXIT} $(date '+%Y-%m-%d %H:%M:%S') ==="

PYTHON="${ROOT}/.venv/bin/python"
if [[ -x "${PYTHON}" ]]; then
  STAMP="$(date '+%Y%m%d')"
  EXTRA=""
  [[ -f "${ROOT}/reports/qlib_tw_factor_walkforward.md" ]] && \
    EXTRA+="reports/qlib_tw_factor_walkforward.md"$'\n'
  set +e
  "${PYTHON}" "${ROOT}/scripts/notify_job_result.py" \
    --subject-prefix="週日深度補庫" \
    --exit-code="${EXIT}" \
    --log-path="${ROOT}/logs/weekly_sync_${STAMP}.log" \
    --extra="${EXTRA}" \
    --env-flag="RUN_WEEKLY_DEEP_EMAIL"
  set -e
fi

exit "${EXIT}"
