<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jackm4.goldenstocks.order-wake</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ORDER_WAKE_LAUNCHER}}</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/tmp</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<!-- 每 300 秒；實際 08:50–13:40 由 launcher 過濾（避開 Aqua Calendar 停火） -->
	<key>StartInterval</key>
	<integer>300</integer>
	<key>ExitTimeOut</key>
	<integer>60</integer>
	<!-- stdout 勿指向 Documents（launchd open 會 EX_CONFIG / TCC） -->
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/order-wake.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/com.jackm4.goldenstocks/order-wake.launchd.err.log</string>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
