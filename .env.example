# 複製為 .env（勿提交 .env）
TEJ_API_KEY=
FINMIND_TOKEN=

# 富邦 Neo API · Order layer（scripts/order/fubon_login_test.py · .venv-fubon）
# 建立：python3.13 -m venv .venv-fubon && .venv-fubon/bin/pip install CAFubon/fubon_neo-*.whl
# 執行：.venv-fubon/bin/python scripts/order/fubon_login_test.py [--snapshot]
# 開盤前 brief：.venv-fubon/bin/python scripts/order/morning_holdings_brief.py [--sync-futures] --write
# 策略意圖送單：.venv-fubon/bin/python scripts/order/submit_intents.py reports/order/intents/<file>.json --dry-run
# 開盤排程（已停用 · 原週一至五 09:00–09:04）：scripts/install-order-launchd.sh
# ORDER_LAUNCHD_ENABLED=0   # 設為 1 並 install-order-launchd.sh 才啟用 launchd 送單
FUBON_USER_ID=
FUBON_PASSWORD=
FUBON_CERT_PATH=
FUBON_CERT_PASSWORD=
# FUBON_API_KEY=   # 選填；>= SDK v2.2.7，申請：https://www.fbs.com.tw/TradeAPI/docs/key.txt

# etfedge MCP backfill（scripts/import_etfedge_holdings.py）
# 登入：.venv/bin/python scripts/etfedge_oauth_login.py
ETFEDGE_MCP_TOKEN=

# === 排程通知郵件（Gmail → Mail.app 收件匣；各排程可個別關閉）===
# 方式 A（推薦）：Gmail App 密碼 → https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=
# 或 GMAIL_APP=（與 GMAIL_APP_PASSWORD 擇一；含空格請加引號）
GMAIL_NOTIFY_FROM=your@gmail.com
GMAIL_NOTIFY_TO=your@gmail.com
# 方式 B（選填）：Google Apps Script Web App URL（見下方說明，不需在本機存密碼）
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=
RUN_EVENING_HOLDINGS_EMAIL=1
RUN_WEEKLY_DEEP_EMAIL=1
RUN_RRG_MONO_INTRADAY_EMAIL=1
RUN_VCP_FUNNEL_SPECS_EMAIL=1
RUN_ETFEDGE_IMPORT_EMAIL=1
RUN_RRG_MONO_EMAIL=1
# 安聯台灣科技基金（ACDD04）月報公布偵測；僅新快照寄信
RUN_MUTUAL_FUND_DISCLOSURE_EMAIL=1

# === Supabase · 網站層（Readdy 讀取 · 本機 upsert）===
# 專案 ref: lzaomqzsiqudkojokevr · 三 schema 並存（勿混用）：
#   stock_research — 股市研究（daily_briefs · site_content · strategy_performance_yearly …）
#   photobooking   — 官網預約（booking_logs；非 public）
#   public         — yahoo_quotes · yahoo_daily_bars 快取（無研究表 · 無預約表）
# Readdy 前端：VITE_PUBLIC_SUPABASE_URL + VITE_PUBLIC_SUPABASE_ANON_KEY
#   createClient(..., { db: { schema: 'stock_research' } })
# 本機 upsert：SUPABASE_SERVICE_ROLE_KEY · 手動 backfill 或排程 sync
SUPABASE_URL=https://lzaomqzsiqudkojokevr.supabase.co
SUPABASE_PROJECT_REF=lzaomqzsiqudkojokevr
SUPABASE_SERVICE_ROLE_KEY=
RUN_SUPABASE_RESEARCH_SYNC=0
# 收盤 16:30 lens → Supabase（evening-holdings 預設 1；與 brief sync 分離）
RUN_STOCK_DAILY_LENS=1
RUN_SUPABASE_LENS_SYNC=1
RUN_LENS_DAILY_NOTIFY=0
# 已採納策略分年績效 → Supabase strategy_performance_yearly
RUN_STRATEGY_PERF_SYNC=1
# Regime embed HTML（預設關；Readdy 用 snapshot_json）
RUN_REGIME_EMBED_HTML=0
# 本機 research standalone HTML（RRG timeline 等；非網站 VFP）
RUN_RESEARCH_HTML_GEN=0
# stock_signal_hits 索引（隨 brief sync；預設 1）
RUN_SUPABASE_SIGNAL_SYNC=1

# === ② 收盤持股雷達（週一至五 16:30 · scripts/daily_sync.sh）===
#
# Profile（可選 · 載入 .env 後覆寫 RUN_*）：
#   SYNC_PROFILE=slim  → 僅 ingest + Facts + Regime（策略軌 / Lens / Supabase brief 關）
#   SYNC_PROFILE=full  → 沿用下方 RUN_*（等同不設）
#
# Gate（daily_sync · src/pipeline_gates.py）：
#   1. config/strategies.yaml · enabled=false → SKIP（即使 RUN_*=1）
#   2. RUN_*=0 → SKIP
#   啟用策略軌請同時改 strategies.yaml + strategy.yaml · enabled 一致。
#
RUN_STOCK_MARKET_SYNC=1
# RRG universe close + mono 槽位（需 RUN_STOCK_MARKET_SYNC=1）
RUN_RRG_UNIVERSE_CLOSE=1
RUN_RRG_MONO_DAILY=1
RUN_RRG_MONO_SWAP_ACCEL_DAILY=1
# RRG Improving lifecycle watch brief（archived research · Phase C 預設關 · 手動 RUN_RRG_IMPROVING_WATCH=1）
RUN_RRG_IMPROVING_WATCH=0
# 市場探針（archived topic · Phase C 預設關）
RUN_PROBE_KBAR_BACKFILL=0
RUN_MARKET_PROBE_RADAR=0
# RRG Universe 全檔互動時間軸 HTML（2025-01-02 起 · 更新至最新交易日）
RUN_RRG_UNIVERSE_TIMELINE=1
STOCK_MARKET_LOOKBACK_DAYS=60
STOCK_MARKET_FORCE_REFRESH=0
RUN_CHIP_SYNC=1
CHIP_LOOKBACK_DAYS=14
RUN_SPONSOR_CHIP_SYNC=1
SPONSOR_CHIP_TOP_N=20
# screener / 回測資料增量（daily_sync 16:30 · weekly_sync 週日；需 FinMind Backer/Sponsor 取市值）
RUN_SCREENER_DATA_SYNC=1
SCREENER_SHAREHOLDING_LOOKBACK_DAYS=30
SCREENER_DIVIDEND_LOOKBACK_DAYS=800
SCREENER_MARKET_VALUE_LOOKBACK_DAYS=30
SCREENER_FUTURES_LOOKBACK_DAYS=14
SCREENER_TECHNICAL_LOOKBACK_DAYS=30

# === VCP Pivot Gate / Coil Close（週一至五 13:00 · scripts/launchd/vcp-funnel-specs.command）===
RUN_VCP_FUNNEL_SPECS=1
# 收盤後 VCP funnel 正式 screen + brief（daily_sync 16:30；需 RUN_STOCK_MARKET_SYNC=1）
RUN_VCP_FUNNEL_CLOSE=1

# === RRG mono（週一至五 13:00 預警 · 16:30 daily_sync 收盤確認）===
RUN_RRG_MONO_INTRADAY_WATCH=1
# 13:00 全 universe RRG 寫 SQLite + Supabase（併入 intraday-watch job）
RUN_RRG_UNIVERSE_SNAPSHOT=1
# RRG_MONO_ETF_CODES=00981A,00403A,009816,00980A,00982A,00992A

# === C18acc · rrg-mono-swap-accel live screen（严格对齐回测 · backtest_pit）===
# 5m poll：scripts/install-launchd.sh → com.jackm4.etf.rrg-c18acc-poll
RUN_RRG_C18ACC_SCREEN=1
ORDER_C18ACC_DRY_RUN=1
ORDER_C18ACC_APPLY_STATE=0
RUN_RRG_C18ACC_EMAIL=0
C18ACC_KBAR_SYNC=1
C18ACC_BUDGET_TWD_PER_SLOT=20000
# 0=零股（預設 floor 預算／價）· 1=整張（1000 股倍數）
C18ACC_BOARD_LOT=0
# 可選：手動候選（預設關閉 · 走昨收 PIT fresh mono 全池）
# C18ACC_POOL_OVERRIDE=3711,6488
# C18ACC_POOL_OVERRIDE_DATE=2026-06-24
# intent 預覽：.venv-fubon/bin/python scripts/order/submit_intents.py reports/order/intents/rrg-mono-swap-accel_<date>.json --dry-run

# === Advisory signal radar（buy/sell 分軌 · 5m poll · 僅寄信 · 人工下單）===
# install-launchd → com.jackm4.etf.buy-signal-radar · com.jackm4.etf.sell-signal-radar
RUN_BUY_SIGNAL_RADAR=1
RUN_SELL_SIGNAL_RADAR=1
RUN_BUY_SIGNAL_EMAIL=1
RUN_SELL_SIGNAL_EMAIL=1
SIGNAL_RADAR_SELL_HELD_ONLY=1
# 持倉 S0/S1a/S1b/S2/S2-lite 結構停損 advisory（讀 08:50 snapshot + 09:06 gate）
SIGNAL_RADAR_STRUCTURAL_EXIT=1
SIGNAL_RADAR_S1A_VCP=1
SIGNAL_RADAR_HOLDINGS_STRESS=1
SIGNAL_RADAR_S0_WATCH=1
SIGNAL_RADAR_S0B_WATCH=1
SIGNAL_RADAR_USE_FUBON=1
# 08:50 morning brief · 09:05 gate · 09:06 開盤解讀 · 11:00/13:02 持倉脈動（install-launchd）
RUN_MORNING_HOLDINGS_EMAIL=0
RUN_INTRADAY_EXIT_GATE_EMAIL=0
RUN_INTRADAY_OPEN_DIGEST=1
RUN_INTRADAY_OPEN_DIGEST_EMAIL=1
RUN_INTRADAY_MIDDAY_DIGEST=1
RUN_INTRADAY_MIDDAY_DIGEST_EMAIL=1
RUN_INTRADAY_1300_DIGEST=1
RUN_INTRADAY_1300_DIGEST_EMAIL=1
RUN_HOLDINGS_PULSE_IN_DIGEST=1
# 持倉脈動 RRG 盤中：1m K @ poll_minute（缺 K fallback tick）；現價仍用富邦即時
HOLDINGS_PULSE_RRG_KBAR=1
HOLDINGS_PULSE_KBAR_SYNC=1
INTRADAY_GATE_KBAR_SYNC=1
# 賣方宇宙：kbar=監測清單∩當日有1mK · watchlist=全清單（需同步K）
SIGNAL_RADAR_SELL_UNIVERSE=kbar
# 盤前補齊 1m K（監測清單 149 檔 · 約 2 分鐘/日）：
#   PYTHONPATH=src .venv/bin/python scripts/backfill_signal_radar_kbar.py --date $(date +%Y-%m-%d)
SIGNAL_RADAR_UNIVERSE_MIN_HOLD_DAYS=0
# Replay 加速（僅 scripts/run_launchd_replay · run_signal_radar_replay 自動設 1）：
# SIGNAL_RADAR_REPLAY_FAST=1  · session 快取日 K 池與賣方全日 extension
# dedup state：data/signal_radar_dedup.json · buy confirm：data/signal_radar_buy_state.json

# === ABC v3+f1 自動下單（buy-signal-radar 命中 · Order layer）===
# 預設啟用：2 萬/檔 · 單日最多 5 檔（≈10 萬）· re-entry 見 config/order.yaml
ABC_V3_F1_ORDER_ENABLED=1
ABC_V3_F1_AUTO_SUBMIT=1
ABC_V3_F1_BUDGET_TWD=20000
ABC_V3_F1_MAX_ENTRIES_DAY=5
ABC_V3_F1_HOLD_DAYS=3
ABC_V3_F1_REENTRY_DISCOUNT_PCT=2.0
ABC_V3_F1_MAX_NOTIONAL_SYMBOL=60000
ABC_V3_F1_POLL_MAX_ATTEMPTS=3
ABC_V3_F1_POLL_INTERVAL_SEC=2.0
ABC_V3_F1_NOTIONAL_BASIS=submitted
RUN_ABC_V3_F1_SUBMIT_EMAIL=1
# ledger：data/order/abc_v3_f1_ledger.json · intent：reports/order/intents/

# === Minervini SEPA basket（週一至五 16:35 · scripts/launchd/minervini-sepa-basket.command）===
RUN_MINERVINI_SEPA_SCREEN=1
ORDER_MINERVINI_SEPA_DRY_RUN=1
RUN_MINERVINI_SEPA_EMAIL=1
MINERVINI_SEPA_CAPITAL_NTD=100000

# === C18acc Extension overlay（legacy 1m · 已由 sell-signal-radar 取代 · 保留手動腳本）===
RUN_C18ACC_EXTENSION_SCREEN=1
RUN_C18ACC_EXTENSION_EMAIL=1
RUN_C18ACC_EXTENSION_OVERLAY=0
C18ACC_EXTENSION_MODE=combo_spike
C18ACC_EXTENSION_MIN_SPIKE_PCT=4
C18ACC_EXTENSION_MIN_FADE_PCT=1.0
C18ACC_EXTENSION_POLL_MIN=1
C18ACC_EXTENSION_WATCH_HEAT=70
C18ACC_EXTENSION_HEAT=70
C18ACC_EXTENSION_DRY_RUN=1
C18ACC_EXTENSION_EMIT_INTENT=0
C18ACC_EXTENSION_APPLY_STATE=0
# log: logs/c18acc_extension_overlay.log · reports/order/extension_overlay/

# === 週日深度補庫（scripts/weekly_sync.sh）===
# alphalens-style 因子驗證（較重，預設關）
RUN_FACTOR_VALIDATION=0
# screener 增量（與 daily_sync 相同五層；週日亦跑一輪）
RUN_SCREENER_DATA_SYNC=1

# === 研究參數（非 daily close）===
ENTRY_OVEREXTENDED_ABS_MIN=13
ENTRY_OVEREXTENDED_REL_PCT=78
PORTFOLIO_CAPITAL_NTD=100000

