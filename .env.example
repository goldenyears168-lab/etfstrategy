SUPABASE_PROJECT_REF=lzaomqzsiqudkojokevr
SUPABASE_SERVICE_ROLE_KEY=
RUN_SUPABASE_RESEARCH_SYNC=0  # RETIRED 2026-07-23 · public site removed
